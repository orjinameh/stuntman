# Stuntman reads these from the process environment. It does not load .env files: `export` them or use `env $(cat .env)`.
STUNTMAN_MODE=fixture        # fixture (default, offline) or live (same as passing --live)
KANE_BIN=kane-cli            # path or name of the Kane CLI binary
KANE_HEADLESS=0              # 1 adds --headless to kane-cli (use in CI)
KANE_TIMEOUT_GRACE_MS=30000  # extra time past --timeout before Stuntman kills a Kane run
NO_COLOR=                    # set to any value to disable ANSI colour
PORT=3000                    # port for the demo storefront (demo/app/server.mjs); demo/second uses 3100
LT_USERNAME=                 # CI live job only: your TestMu AI username (never commit a value)
LT_ACCESS_KEY=               # CI live job only: your TestMu AI access key (never commit a value)
