{
  "name": "stuntman-web",
  "version": "0.1.0",
  "private": true,
  "description": "Judge-facing Next.js site for Stuntman (additive: the root Node CLI is untouched).",
  "scripts": {
    "predev": "node scripts/sync-evidence.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-evidence.mjs",
    "build": "next build",
